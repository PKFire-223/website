# ==============================================================================
# PLANORA LMS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn: Tạo bản sao của file này và đổi tên thành '.env'
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Cổng chạy ứng dụng (Mặc định 3000)
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MONGODB)
# ------------------------------------------------------------------------------
# Lưu ý quan trọng:
# - Nếu để trống hoặc chưa cấu hình MONGODB_URI, hệ thống sẽ TỰ ĐỘNG CHẠY Ở CHẾ ĐỘ
#   IN-MEMORY STORE (lưu trên RAM tạm thời). Bạn vẫn có thể trải nghiệm đầy đủ
#   tất cả tính năng mà không cần cài đặt MongoDB!
#
# Ví dụ kết nối Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/personal_lms
#
# Ví dụ kết nối MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/personal_lms?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & ROLES)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực JSON Web Token (JWT)
JWT_SECRET=planora_jwt_secret_key_change_in_production_min_32_chars

# Tài khoản Admin mặc định khi nạp dữ liệu mẫu
SEED_SYSTEM_ADMIN_EMAIL=systemadmin@gmail.com
SEED_SYSTEM_ADMIN_PASSWORD=@Systemadmin

# Tài khoản Tester mặc định
SEED_TESTER_EMAIL=Tester123@gmail.com
SEED_TESTER_PASSWORD=Password123@

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ASSISTANT (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Khóa API của Google Gemini để kích hoạt trợ lý học tập AI, chia nhỏ bài tập
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL SERVICE (TÙY CHỌN CHO QUÊN MẬT KHẨU / OTP THỰC)
# ------------------------------------------------------------------------------
# Nếu để trống, hệ thống sẽ tự động sử dụng tài khoản Ethereal Mail giả lập
# và in đường link xem email OTP trực tiếp trong console terminal để test nhanh!
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="Planora LMS Support <no-reply@planora.edu.vn>"
